/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# ═══ لا كاش طويل بلا بصمة ═══
# أسماء الملفّات ثابتة (app.js · theme.css)، فـimmutable يعني مستخدماً
# عالقاً سنةً على نسخةٍ قديمة بعد أي ترقية. no-cache تُجبر المتصفّح على
# التحقّق (304 إن لم يتغيّر) فلا كلفةَ على النسخة نفسها ولا جمودَ عند
# الترقية. وهذا الملفّ يُقرأ مع netlify.toml — فلا يجوز أن يخالفه.
/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache
